<?xml version="1.0"?>
<ruleset name="Kehai"
	xmlns="http://pmd.sf.net/ruleset/1.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd"
	xsi:noNamespaceSchemaLocation="http://pmd.sf.net/ruleset_xml_schema.xsd">
	<description>PHP Mess Detector rules for Kehai. Every excluded rule has its reason next to it; the limits are the PHPMD defaults.</description>

	<rule ref="rulesets/cleancode.xml">
		<!-- Config, Events, Plugin and the other classes are static services: they take the Kirby app or the configuration as an argument (IDM-2). -->
		<exclude name="StaticAccess" />
		<!-- The country switch of Events::read() and of the Digistore24 source is an on/off option. -->
		<exclude name="BooleanArgumentFlag" />
		<!-- The assignment in a condition keeps the status cascade in reading order. -->
		<exclude name="IfStatementAssignment" />
		<!-- Some guards read better with else than with an early return. -->
		<exclude name="ElseExpression" />
		<!-- @ silences the warnings of file_get_contents(), fopen(), mkdir() and unlink(); each call checks the return value. -->
		<exclude name="ErrorControlOperator" />
	</rule>

	<rule ref="rulesets/codesize.xml">
		<!-- Config, Digistore24, Events and Check are above the class limit: each one is one data source or one report, kept as one class. -->
		<exclude name="ExcessiveClassComplexity" />
	</rule>

	<rule ref="rulesets/design.xml" />

	<rule ref="rulesets/naming.xml">
		<!-- Loop and closure variables such as $e, $m and $t are short by convention. -->
		<exclude name="ShortVariable" />
		<!-- t() is the translation shorthand used in snippets and tests; id() is the source id. -->
		<exclude name="ShortMethodName" />
	</rule>

	<rule ref="rulesets/unusedcode.xml" />
</ruleset>
