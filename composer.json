{
    "name": "sayamaapps/kirby-kehai",
    "description": "Honest social proof for Kirby CMS: real Digistore24 purchases, shown without personal data.",
    "type": "kirby-plugin",
    "license": "MIT",
    "keywords": ["kirby", "kirby-plugin", "kirby-5", "social-proof", "digistore24", "privacy", "gdpr", "csp"],
    "homepage": "https://github.com/sayamaapps/kirby-kehai",
    "authors": [
        {
            "name": "Simon Räder",
            "homepage": "https://sayamaapps.de"
        }
    ],
    "support": {
        "issues": "https://github.com/sayamaapps/kirby-kehai/issues",
        "source": "https://github.com/sayamaapps/kirby-kehai"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "getkirby/composer-installer": "^1.2"
    },
    "require-dev": {
        "getkirby/cms": "^5.0",
        "phpunit/phpunit": "11.5.55"
    },
    "bin": [
        "bin/kehai"
    ],
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": {
            "getkirby/composer-installer": true
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "extra": {
        "installer-name": "kehai",
        "kirby-cms-path": false,
        "kirby": {
            "compatible": "^5.0"
        }
    }
}
