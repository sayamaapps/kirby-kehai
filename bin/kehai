#!/usr/bin/env php
<?php
/**
 * Kehai on the command line, from the project root:
 *
 *   DIGISTORE24_API_KEY=… vendor/bin/kehai fetch   # source → anonymous data file
 *   vendor/bin/kehai check                         # configuration, file, events per product
 *
 * Manual installation: php site/plugins/kehai/bin/kehai …
 * Details in src/Cli.php and the README ("Operation").
 */
if (PHP_SAPI !== 'cli') {
	http_response_code(404);
	exit;
}

// The class map, loaded without Kirby (the CLI runs before a site is booted).
$kehaiClasses = require dirname(__DIR__) . '/autoload.php';
spl_autoload_register(static function (string $class) use ($kehaiClasses): void {
	$file = $kehaiClasses[strtolower($class)] ?? null;
	if ($file !== null) {
		require dirname(__DIR__) . '/' . $file;
	}
});

exit(Sayamaapps\Kehai\Cli::main(getenv(), $argv, (string) getcwd(), STDOUT, STDERR));
